{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Serilog": {
      "LogLevel": {
        "Default": "Critical",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "SerilogLogging": {
    "File": {
      "Enabled": true,
      "Path": "../../.logs/log-.txt"
    }
  },
  "AllowedHosts": "*"
}
